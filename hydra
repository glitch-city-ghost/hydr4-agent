#!/usr/bin/env bash

# Hydra CLI — a thin, transparent wrapper around Docker Compose.
# It manages containers. It does not touch Git, data, or hidden state.
#
# Something broke? Read WTF_EVERYTHING_BROKE_DOWN_HELP.md

set -euo pipefail

cd "$(dirname "$0")" || exit 1

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Load variables from .env
if [ -f .env ]; then
    set -a
    # shellcheck disable=SC1091
    . ./.env
    set +a
fi

COMPOSE=(docker compose --profile opencode)
WAIT_TIMEOUT=180

usage() {
    cat <<'EOF'
Hydra CLI — a thin wrapper around Docker Compose.

Usage: ./hydra <command> [args]

  start      Start the stack and wait for healthchecks
  stop       Stop the stack
  restart    Recreate containers without rebuilding (picks up configs/)
  rebuild    Rebuild images from scratch, then recreate containers
  status     Show containers, current commit, and working tree state
  logs [svc] Follow logs (all services by default)
  check      Shallow, read-only health check (no model calls, no tokens)
  web        Print the Agent UI URL
  cli        Open a shell inside the agent container

Something broke? WTF_EVERYTHING_BROKE_DOWN_HELP.md
EOF
}

case "${1:-}" in
    start)
        echo -e "${YELLOW}Starting Hydra (Gateway + Agent)...${NC}"
        "${COMPOSE[@]}" up -d --wait --wait-timeout "$WAIT_TIMEOUT" --remove-orphans

        echo -e "${GREEN}Done.${NC}"
        echo -e "• Agent UI:   http://agent.localhost"
        echo -e "• Gateway UI: http://api.localhost"
        echo -e "Run ${GREEN}./hydra check${NC} to verify the obvious stuff."
        ;;
    stop)
        echo -e "${YELLOW}Stopping Hydra...${NC}"
        "${COMPOSE[@]}" down --remove-orphans
        ;;
    restart)
        echo -e "${YELLOW}Recreating containers (no rebuild)...${NC}"
        "${COMPOSE[@]}" up -d --force-recreate --wait --wait-timeout "$WAIT_TIMEOUT" --remove-orphans
        echo -e "${GREEN}Done.${NC}"
        ;;
    rebuild)
        echo -e "${YELLOW}Rebuilding from scratch (this can take a while)...${NC}"
        "${COMPOSE[@]}" build --pull --no-cache
        "${COMPOSE[@]}" pull --ignore-pull-failures gateway
        "${COMPOSE[@]}" up -d --force-recreate --wait --wait-timeout "$WAIT_TIMEOUT" --remove-orphans
        echo -e "${GREEN}Done.${NC}"
        echo -e "Run ${GREEN}./hydra check${NC} to verify the obvious stuff."
        ;;
    status)
        "${COMPOSE[@]}" ps --all
        echo
        printf 'Commit:       '
        git log -1 --oneline
        if [ -n "$(git status --porcelain)" ]; then
            echo "Working tree: dirty (uncommitted changes)"
        else
            echo "Working tree: clean"
        fi
        ;;
    logs)
        shift
        "${COMPOSE[@]}" logs -f --tail=100 "$@"
        ;;
    check)
        exec bash scripts/check.sh
        ;;
    web)
        echo -e "Open in browser: ${GREEN}http://localhost:4096${NC}"
        ;;
    cli)
        echo -e "${YELLOW}Opening a shell inside the agent...${NC}"
        "${COMPOSE[@]}" exec agent bash
        ;;
    help|--help|-h|"")
        usage
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo
        usage
        exit 1
        ;;
esac
