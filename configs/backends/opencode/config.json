{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "default_agent": "engineer",
  "websearch": {
    "provider": "exa"
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 1
  },
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "rm -fr *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "allow" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "gh *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr close*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr review*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr revert*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr lock*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr unlock*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr update-branch*", "effect": "deny" },
    { "action": "shell", "resource": "gh api*", "effect": "deny" },
    { "action": "shell", "resource": "gh auth token*", "effect": "deny" },
    { "action": "shell", "resource": "gh auth login*", "effect": "deny" },
    { "action": "shell", "resource": "gh auth logout*", "effect": "deny" },
    { "action": "shell", "resource": "gh auth setup-git*", "effect": "deny" },
    { "action": "shell", "resource": "gh repo delete*", "effect": "deny" },
    { "action": "shell", "resource": "gh repo edit*", "effect": "deny" },
    { "action": "shell", "resource": "gh secret*", "effect": "deny" },
    { "action": "shell", "resource": "gh variable*", "effect": "deny" },
    { "action": "shell", "resource": "gh workflow*", "effect": "deny" },
    { "action": "shell", "resource": "gh release*", "effect": "deny" },
    { "action": "shell", "resource": "git push* --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push* -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push* --delete*", "effect": "deny" },
    { "action": "shell", "resource": "git push* --mirror*", "effect": "deny" },
    { "action": "shell", "resource": "git push* --prune*", "effect": "deny" },
    { "action": "shell", "resource": "git push* --all*", "effect": "deny" },
    { "action": "shell", "resource": "git push* +*", "effect": "deny" },
    { "action": "shell", "resource": "git push* :*", "effect": "deny" }
  ],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 20000
    }
  },
  "tool_output": {
    "max_lines": 1500,
    "max_bytes": 49152
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      "*.log"
    ]
  },
  "skills": ["/configs/backends/opencode/skills"],
  "agents": {
    "engineer": {
      "description": "Primary coding agent. Model follows the session model.",
      "mode": "primary",
      "system": "{file:./prompts/engineer.md}",
      "steps": 50
    },
    "engineer-nemotron": {
      "description": "Deep-reasoning backup coding agent on the direct NVIDIA NIM endpoint. Use when DeepSeek tokens are exhausted or the task needs more analysis.",
      "mode": "primary",
      "model": "nvidia-nim/nemotron-3-ultra-550b",
      "temperature": 1.0,
      "top_p": 0.95,
      "system": "{file:./prompts/engineer-nemotron.md}",
      "steps": 80
    },
    "explore": {
      "model": "hydr4/nemotron-3-ultra-550b",
      "steps": 12
    },
    "plan": {
      "steps": 16
    },
    "reviewer": {
      "description": "Read-only diff reviewer and security auditor. Reports concrete defects only.",
      "mode": "subagent",
      "model": "hydr4/nemotron-3-ultra-550b",
      "system": "{file:./prompts/reviewer.md}",
      "steps": 12,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "verifier": {
      "description": "Runs verification commands and reports compact results. Never edits files.",
      "mode": "subagent",
      "model": "hydr4/nemotron-3-ultra-550b",
      "system": "{file:./prompts/verifier.md}",
      "steps": 12,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "title": {
      "model": "hydr4/nemotron-3-ultra-550b"
    },
    "summary": {
      "model": "hydr4/nemotron-3-ultra-550b"
    },
    "compaction": {
      "model": "hydr4/nemotron-3-ultra-550b"
    },
    "pipeline": {
      "description": "Multi-stage Nemotron pipeline agent. Uses direct NVIDIA NIM with max reasoning.",
      "mode": "primary",
      "model": "nvidia-nim/nemotron-3-ultra-550b",
      "temperature": 1.0,
      "top_p": 0.95,
      "system": "{file:./pipeline/pipeline.md}",
      "steps": 80
    },
    "tech-lead-pm": {
      "description": "Tech Lead / PM. Defines requirements, breaks down work, plans iterations, accepts deliverables.",
      "mode": "subagent",
      "model": "nvidia-nim/nemotron-3-ultra-550b",
      "temperature": 1.0,
      "top_p": 0.95,
      "system": "{file:./pipeline/tech-lead-pm.md}",
      "steps": 60,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "architect": {
      "description": "Software Architect. Designs system structure, APIs, data models, and technical approach.",
      "mode": "subagent",
      "model": "nvidia-nim/nemotron-3-ultra-550b",
      "temperature": 1.0,
      "top_p": 0.95,
      "system": "{file:./pipeline/architect.md}",
      "steps": 60,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "architecture-judge": {
      "description": "Architecture Judge. Reviews architectural decisions for correctness, tradeoffs, and long-term viability.",
      "mode": "subagent",
      "model": "nvidia-nim/nemotron-3-ultra-550b",
      "temperature": 0.3,
      "top_p": 0.9,
      "system": "{file:./pipeline/architecture-judge.md}",
      "steps": 40,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "coder": {
      "description": "Coder. Implements the design. Writes clean, correct code matching conventions.",
      "mode": "subagent",
      "model": "nvidia-nim/nemotron-3-ultra-550b",
      "temperature": 0.3,
      "top_p": 0.9,
      "system": "{file:./pipeline/coder.md}",
      "steps": 80
    },
    "pipeline-reviewer": {
      "description": "Pipeline Reviewer. Reviews code for correctness, security, performance, and adherence to design.",
      "mode": "subagent",
      "model": "nvidia-nim/nemotron-3-ultra-550b",
      "temperature": 0.1,
      "top_p": 0.8,
      "system": "{file:./pipeline/pipeline-reviewer.md}",
      "steps": 40,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "tech-lead-release-gate": {
      "description": "Tech Lead Release Gate. Final acceptance check. Verifies deliverables meet all requirements and quality bars.",
      "mode": "subagent",
      "model": "nvidia-nim/nemotron-3-ultra-550b",
      "temperature": 0.2,
      "top_p": 0.85,
      "system": "{file:./pipeline/tech-lead-release-gate.md}",
      "steps": 30,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "commands": {
    "plan": {
      "description": "Plan a task without editing files",
      "agent": "plan",
      "template": "Plan the following work. Explore the code first, then produce a concrete step-by-step plan: files to touch, order of operations, risks, and how to verify. Do not edit files.\n\n$ARGUMENTS"
    },
    "explore": {
      "description": "Delegate a read-only investigation to the explore subagent",
      "agent": "explore",
      "template": "Investigate and report. Questions:\n\n$ARGUMENTS\n\nOutput format:\n- FILES: exact paths with line numbers\n- FACTS: only what you verified by reading, no speculation\n- UNCERTAIN: what you could not determine\nKeep it under 500 words."
    },
    "review": {
      "description": "Review the current uncommitted diff",
      "agent": "reviewer",
      "template": "Review the current uncommitted diff. Report only concrete defects with file:line and evidence, highest severity first, maximum 7 findings. No style nitpicks, no praise. If there is nothing, say NO FINDINGS.\n\n$ARGUMENTS"
    },
    "verify": {
      "description": "Run the project's checks and report results",
      "agent": "verifier",
      "template": "Verify the current changes. If a command is given below, run exactly that command. Otherwise detect the standard test, lint, and typecheck commands from the repository manifests and run only those. Do not modify any files.\n\n$ARGUMENTS"
    },
    "pr": {
      "description": "Open or update a pull request for the current branch",
      "agent": "engineer",
      "template": "Open or update a pull request for the current branch. Load and follow the github-pr skill. Use the real diff and only verification you actually ran. If an open PR already exists for this branch, update its description instead of creating a duplicate. Never merge, approve, close, or force-push. Report the PR URL and the CI status.\n\n$ARGUMENTS"
    },
    "handoff": {
      "description": "Write a compact handoff for a fresh session",
      "template": "Write a handoff for a fresh session. Terse, no process narration. Sections: GOAL, DECISIONS, CHANGED FILES, OPEN QUESTIONS, NEXT ACTION.\n\n$ARGUMENTS"
    }
  },
  "providers": {
    "hydr4": {
      "name": "Hydra Gateway",
      "env": ["HYDRA_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://gateway:3001/v1",
        "timeout": 2400000,
        "headerTimeout": 2400000,
        "chunkTimeout": 2400000
      },
      "models": {
        "nemotron-3-ultra-550b": {
          "name": "NVIDIA Nemotron 3 Ultra 550B",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        }
      }
    },
    "deepseek": {
      "env": ["HYDRA_API_KEY"],
      "settings": {
        "baseURL": "http://gateway:3001/v1",
        "apiKey": "{env:HYDRA_API_KEY}",
        "timeout": 2400000,
        "headerTimeout": 2400000,
        "chunkTimeout": 2400000
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    },
    "nvidia-nim": {
      "name": "NVIDIA NIM (direct)",
      "env": ["NVIDIA_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "timeout": 2400000,
        "headerTimeout": 2400000,
        "chunkTimeout": 2400000
      },
      "models": {
        "nemotron-3-ultra-550b": {
          "modelID": "nvidia/nemotron-3-ultra-550b-a55b",
          "name": "NVIDIA Nemotron 3 Ultra 550B (direct)",
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          },
          "body": {
            "temperature": 1.0,
            "top_p": 0.95,
            "max_tokens": 32768,
            "reasoning_effort": "high",
            "reasoning_budget": -1,
            "chat_template_kwargs": {
              "enable_thinking": true,
              "force_nonempty_content": true
            }
          },
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        }
      }
    }
  }
}
