{
  "$schema": "https://opencode.ai/config.json",
  "model": "hydr4/nemotron-3-ultra-550b",
  "providers": {
    "hydr4": {
      "name": "Hydra Aggregator",
      "env": ["HYDRA_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://aggregator:3001/v1",
        "timeout": 2400000,
        "chunkTimeout": 2400000
      },
      "models": {
        "nemotron-3-ultra-550b": {
          "name": "NVIDIA Nemotron 550B",
          "capabilities": {
            "tools": true
          }
        }
      }
    },
    "deepseek": {
      "env": ["HYDRA_API_KEY"],
      "settings": {
        "baseURL": "http://aggregator:3001/v1",
        "apiKey": "{env:HYDRA_API_KEY}",
        "timeout": 2400000,
        "chunkTimeout": 2400000
      }
    }
  }
}
