{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "default_agent": "build",
  "username": "hydr4-agent",
  "update": "disable",
  "snapshots": true,
  "formatter": true,
  "instructions": [
    "/configs/backends/opencode/AGENTS.md"
  ],
  "skills": [
    "/configs/backends/opencode/skills"
  ],
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": "15%"
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".git/**",
      "*.log"
    ]
  },
  "experimental": {
    "todo": true
  },
  "providers": {
    "deepseek": {
      "name": "Hydra Gateway (DeepSeek)",
      "env": [
        "HYDRA_API_KEY"
      ],
      "settings": {
        "baseURL": "http://gateway:3001/v1",
        "apiKey": "{env:HYDRA_API_KEY}",
        "timeout": 2400000,
        "headerTimeout": 2400000,
        "chunkTimeout": 2400000
      }
    },
    "hydr4": {
      "name": "Hydra Gateway (Alternatives)",
      "env": [
        "HYDRA_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://gateway:3001/v1",
        "apiKey": "{env:HYDRA_API_KEY}",
        "timeout": 2400000,
        "headerTimeout": 2400000,
        "chunkTimeout": 2400000
      },
      "models": {
        "nemotron-3-ultra-550b": {
          "name": "NVIDIA Nemotron 3 Ultra 550B",
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "auto": {
          "name": "Hydra Auto (gateway router)",
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
