# FreeLLMAPI public runtime settings.
# Secrets (ENCRYPTION_KEY, FREELMAPI_UNIFIED_KEY, UPSTREAM_PROXY, ...) stay in
# the root .env and are loaded into the container by compose env_file.
#
# This file is intentionally tracked: it contains no credentials.

PORT=3001
HOST_BIND=0.0.0.0
# Destinations that bypass UPSTREAM_PROXY (HTTP_PROXY/HTTPS_PROXY).
# The proxy address itself is host-specific and stays in the root .env.
NO_PROXY=localhost,127.0.0.1

# FreeLLMAPI provider budgets/timeouts (milliseconds).
FALLBACK_TIME_BUDGET_MS=600000
PROVIDER_STREAM_STALL_TIMEOUT_MS=600000
PROVIDER_TIMEOUT_CUSTOM=600000
PROVIDER_TIMEOUT_NVIDIA=600000
