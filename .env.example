# ==========================================
# hydr4-agent Environment Variables
# ==========================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env

# --- Gateway / Egress ---
# Public FreeLLMAPI runtime settings live in the tracked config file:
#   configs/gateway/freellmapi/freellmapi.env
# Gateway image/port are currently selected in compose/gateway.yaml.
#
# The upstream proxy to use for outbound LLM traffic (WSL2 -> mihomo).
# mihomo is a native l3rn4-nix service, not a Docker container. It binds every
# interface (bind-address: "*", allow-lan: true), so any address of the host
# works from inside a container -- for example the docker0 bridge address
# (172.17.0.1 on a host that has not changed Docker's default subnet) or
# host.docker.internal. Only the gateway uses it; the agent egresses directly.
# This value is host-specific: it lives here and in your .env, never in
# configs/.
UPSTREAM_PROXY=http://172.17.0.1:7890

# --- Secrets & Keys (REQUIRED) ---
# Generate a random 32-byte hex string (e.g., `openssl rand -hex 32`)
ENCRYPTION_KEY=

# The master key generated by FreeLLMAPI on the first run (check logs or UI)
FREELMAPI_UNIFIED_KEY=

# Password to access the OpenCode Web UI
OPENCODE_PASSWORD=mysecretpassword

# --- Agent Configuration ---
# Which agent to run: "opencode" or "dsh"
AGENT_BACKEND=opencode

# --- Optional: Direct Provider Keys ---
# Note: Usually added via the FreeLLMAPI UI, but can be passed here if needed.
# GOOGLE_AI_STUDIO_API_KEY=
# DEEPSEEK_API_KEY=
